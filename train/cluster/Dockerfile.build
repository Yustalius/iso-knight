# Linux toolchain for libsquad and the training code, without a GPU:
#   docker build -t squad-build -f train/cluster/Dockerfile.build train/cluster
# Debian 12 (glibc 2.36) is older than the cluster image (Ubuntu 24.04, glibc 2.39), so a squad.so built here loads there.
FROM mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends clang zlib1g-dev python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/py && /opt/py/bin/pip install --no-cache-dir -U pip && /opt/py/bin/pip install --no-cache-dir numpy \
    && /opt/py/bin/pip install --no-cache-dir torch --extra-index-url https://download.pytorch.org/whl/cpu
ENV PATH=/opt/py/bin:$PATH DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
